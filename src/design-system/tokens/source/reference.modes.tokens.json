{
  "$description": "Reference values used only by the product and density modifiers. Kept apart from reference.tokens.json so product palettes can be added without touching the core palette.",
  "color": {
    "$type": "color",
    "care": {
      "$description": "The care brand ramp, shared by the patient app and the provider workspace: a calm, clinical teal.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9412, 0.9922, 0.9804], "hex": "#f0fdfa" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.8, 0.9843, 0.9451], "hex": "#ccfbf1" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.6, 0.9647, 0.8941], "hex": "#99f6e4" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.3686, 0.9176, 0.8314], "hex": "#5eead4" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.1765, 0.8314, 0.749], "hex": "#2dd4bf" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.0784, 0.7216, 0.651], "hex": "#14b8a6" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.051, 0.5804, 0.5333], "hex": "#0d9488" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4627, 0.4314], "hex": "#0f766e" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.0667, 0.3686, 0.349], "hex": "#115e59" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.0745, 0.3059, 0.2902], "hex": "#134e4a" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0157, 0.1843, 0.1804], "hex": "#042f2e" } },
      "975": {
        "$value": { "colorSpace": "srgb", "components": [0.0118, 0.1412, 0.1373], "hex": "#032423" },
        "$description": "Dark tinted surface; 950 left strong borders under 3:1."
      }
    },
    "care-glow": {
      "$value": { "colorSpace": "srgb", "components": [0.0784, 0.7216, 0.651], "alpha": 0.55 },
      "$description": "Halo around the care brand's signal indicator on dark surfaces."
    },
    "care-glow-soft": {
      "$value": { "colorSpace": "srgb", "components": [0.051, 0.5804, 0.5333], "alpha": 0.28 },
      "$description": "Halo around the care brand's signal indicator on light surfaces."
    }
  },
  "size": {
    "$type": "dimension",
    "compact": {
      "$description": "Control heights for the compact density. The smallest still exceeds the 24px WCAG 2.2 target-size minimum.",
      "sm": { "$value": { "value": 1.75, "unit": "rem" } },
      "md": { "$value": { "value": 2.25, "unit": "rem" } },
      "lg": { "$value": { "value": 2.75, "unit": "rem" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "plex-sans": {
        "$value": ["IBM Plex Sans Variable", "IBM Plex Sans", "Helvetica Neue", "Arial", "system-ui", "sans-serif"],
        "$description": "The products' typeface: an engineered grotesque with open apertures that stays legible in dense rows and on small screens."
      }
    }
  }
}
